#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return
PS1='[\u@\h \W]\$ '

# golang stuff
export GOPATH=$HOME/.go

export GOROOT_REF=$GOROOT
export GOPATH_REF=$GOPATH
export GOBIN_REF=$GOBIN
# golang stuff end
export TZ='Asia/Bishkek'
export MANPAGER="nvim +Man!"
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH:$HOME/.scripts/bin:$HOME/.local/bin:$GOROOT/bin:$GOPATH/bin"
# export PATH="$PATH:$HOME/.scripts/bin"
export CDPATH=:$HOME/:$HOME/Projects/:$HOME/.config/:..
export BROWSER=/usr/bin/librewolf
export FZF_DEFAULT_OPTS="
    $FZF_DEFAULT_OPTS
    --color fg:7,bg:0,hl:1,fg+:232,bg+:1,hl+:255
    --color info:7,prompt:2,spinner:1,pointer:232,marker:1
"
export ultwear='88:92:CC:A8:A1:81'
export XDG_CACHE_HOME=$HOME/.cache
export XDG_CONFIG_HOME=$HOME/.config

alias pn=pnpm
alias wa='/home/mgik/.scripts/wal/wal.sh '
alias rmpc='rmpc update; rmpc '
alias wiki='wiki-tui '
alias grep='grep --color=always '
alias ls='exa --color=always --icons '
alias ll='ls -l '
alias tree='ls -T --group-directories-first '
alias wifi='nmcli device wifi rescan && nmcli device wifi '

# Pacman stuff
export PACMAN_CONF_PATH="$HOME/.config/pacman/pacman.conf"
alias pacman='pacman --config ${PACMAN_CONF_PATH} '
alias yay='yay --config ${PACMAN_CONF_PATH} '

# Needed to make bash resolve aliases after sudo
alias sudo='sudo '

function cd() {
    builtin cd "$@" && . "$HOME/.scripts/asdf/set_go_envs.bash"
}

. $HOME/.scripts/asdf/set_go_envs.bash

set -o vi

